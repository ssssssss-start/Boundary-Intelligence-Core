  {
    "law_id": "LAW_CODE_LEAK_001",
    "topic": "验证码泄露后的账户安全处置",
    "related_behaviors": [
      "验证码泄露",
      "账户安全",
      "止付冻结"
    ],
    "plain_summary": "验证码泄露可能导致登录、绑卡、转账授权，应立即修改密码、检查异常登录和支付授权，必要时冻结账户。",
    "actions": [
      "修改相关平台和支付账户密码",
      "解绑银行卡或关闭免密支付",
      "联系银行或支付平台检查异常交易"
    ],
    "evidence_to_preserve": [
      "验证码短信时间",
      "异常登录记录",
      "交易记录",
      "对方索要验证码的聊天记录"
    ],
    "disclaimer": "以下为一般账户安全处置建议，不构成法律意见。",
