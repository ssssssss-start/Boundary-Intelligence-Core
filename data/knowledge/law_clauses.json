[
  {
    "law_id": "LAW_PRE_TRANSFER_DISSUASION_001",
    "topic": "转账前高危劝阻与风险核验",
    "related_behaviors": [
      "转账前劝阻",
      "要求转账",
      "证据保存",
      "举报"
    ],
    "plain_summary": "在转账、垫付、充值、缴费或补单前发现疑似诈骗时，应立即停止操作，优先通过官方渠道核验对方身份并保留证据。若对方持续催促或使用恐吓话术，可先举报并向公安机关咨询。",
    "actions": [
      "停止继续转账、充值、缴费或补单",
      "通过官方App、官网或官方客服电话核验",
      "保存聊天记录、收款信息和页面截图"
    ],
    "evidence_to_preserve": [
      "聊天记录",
      "收款账户",
      "催促转账的对话",
      "页面截图"
    ],
    "disclaimer": "以下为一般风险处置建议，不替代公安机关、银行或专业法律意见。",
