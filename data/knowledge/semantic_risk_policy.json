[
  {
    "policy_id": "SEMANTIC_SCENE_ROUTING_V1",
    "policy_type": "scene_routing",
    "title": "语义场景路由原则",
    "enabled": true,
    "priority": 100,
    "rules": [
      {
        "scene": "knowledge_consultation",
        "description": "用户只是在询问诈骗定义、套路、案例、防范、法律法规或学习资料时，不进入风险场景。",
        "workflow_mode": "knowledge_answer",
        "risk_scene": false
      },
      {
        "scene": "personal_risk_scene",
        "description": "用户描述自己、家人或朋友正在被诱导操作，或询问还能不能继续、靠不靠谱、现在怎么办时，进入风险场景。",
        "workflow_mode": "risk_case_flow",
        "risk_scene": true
      },
      {
        "scene": "post_loss_help",
        "description": "用户已经转账、付款、交付账号/装备/虚拟资产、泄露验证码/身份银行卡信息或设备控制权时，进入已损失或已暴露风险场景。",
        "workflow_mode": "risk_case_flow",
        "risk_scene": true
      },
      {
        "scene": "risk_followup",
        "description": "用户正在回答上一轮风险追问，即使只说“有”“没有”“还能”“不能登录”等短句，也交给 LLM 结合上下文理解。",
        "workflow_mode": "risk_case_flow",
        "risk_scene": true
      }
    ],
    "source_refs": [
      "https://www.mps.gov.cn/",
      "https://www.npc.gov.cn/c2/c30834/202209/t20220902_319186.html",
