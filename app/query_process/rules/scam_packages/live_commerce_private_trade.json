      ],
      "weight": 35,
      "explanation": "付款后拒绝退款、拖延售后或再次要求补费用。"
    },
    {
      "feature_name": "虚假授权背书",
      "keywords": [
        "官方授权",
        "专柜同款",
        "品牌尾货",
        "正品保证",
        "假一赔十",
        "厂家直供",
        "内部渠道"
      ],
      "weight": 30,
      "explanation": "用虚假授权、尾货、专柜同款等说法包装商品来源。"
    }
  ],
  "rules": [
    {
      "rule_id": "PKG_LIVE_PRIVATE_TRADE_001",
      "rule_name": "直播带货/私域交易配置化实时劝阻规则",
      "conditions": {
        "all": [
          "私下扫码付款"
        ],
        "any": [
          "明显低价诱导",
          "引导私域下单",
          "拒绝售后退款",
          "虚假授权背书"
        ],
        "min_any": 1
      },
      "risk_score": 82,
      "risk_level": "高风险",
      "intervention_goal": "stop_transfer",
      "explanation": "直播购物或私域团购中出现脱离平台扫码付款，叠加低价、私域下单、售后拖延或虚假授权，触发交易诈骗劝阻。",
      "suggested_action": "不要私下扫码或转账，回到正规平台下单并保留直播间、客服、商品链接和付款凭证；已付款时尽快联系平台和支付渠道申诉。",
      "enabled": true
    }
  ],
