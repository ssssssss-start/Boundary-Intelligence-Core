        "捡漏"
      ],
      "weight": 25,
      "explanation": "用明显低于市场价的商品、清仓或福利价制造购买冲动。"
    },
    {
      "feature_name": "私下扫码付款",
      "keywords": [
        "扫码付款",
        "微信转账",
        "支付宝转账",
        "私下付款",
        "不走平台",
        "直接转账",
        "付到个人账户",
        "收款码"
      ],
      "weight": 40,
      "explanation": "引导脱离直播/电商平台，通过个人码或私下转账付款。"
    },
    {
      "feature_name": "引导私域下单",
      "keywords": [
        "加群",
        "加客服微信",
        "加微信",
        "私域商城",
        "小程序下单",
        "群接龙",
        "福利群",
        "客服微信"
      ],
      "weight": 30,
      "explanation": "把用户从平台直播间引到微信群、小程序或私域客服下单。"
    },
    {
      "feature_name": "拒绝售后退款",
      "keywords": [
        "不退不换",
        "售后拖延",
        "客服失联",
        "退款失败",
        "补邮费",
        "补差价",
