  "rules": [
    {
      "rule_id": "PKG_MEDICAL_INSURANCE_FUND_001",
      "rule_name": "医保骗保/医保卡倒卖配置化实时劝阻规则",
      "conditions": {
        "all": [
          "外借医保凭证"
        ],
        "any": [
          "刷医保返钱",
          "倒卖医保药品",
          "虚假诊疗购药",
          "医保身份信息泄露"
        ],
        "min_any": 1
      },
      "risk_score": 88,
      "risk_level": "高风险",
      "intervention_goal": "stop_sensitive_info",
      "explanation": "外借医保卡、医保码或电子凭证叠加套现、倒卖药品、虚假诊疗或索要身份信息，触发医保基金和个人信息双重风险。",
      "suggested_action": "不要外借医保凭证、刷码返钱或提供验证码/人脸信息；保存聊天和收款信息，向医保部门、药店监管渠道或公安机关核实举报。",
      "enabled": true
    }
  ],
