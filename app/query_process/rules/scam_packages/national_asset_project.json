  "rules": [
    {
      "rule_id": "PKG_NATIONAL_ASSET_PROJECT_001",
      "rule_name": "民族资产解冻/虚假国家项目配置化实时劝阻规则",
      "conditions": {
        "all": [
          "国家项目包装"
        ],
        "any": [
          "伪造红头文件",
          "缴费领取补贴",
          "巨额分红承诺",
          "拉人头扩散"
        ],
        "min_any": 1
      },
      "risk_score": 92,
      "risk_level": "高风险",
      "intervention_goal": "stop_transfer",
      "explanation": "国家项目、民族资产或共同富裕包装叠加缴费、分红、红头文件或拉人头，触发虚假项目诈骗高危劝阻。",
      "suggested_action": "不要缴会员费、激活费、解冻费或转发拉人；通过政府官网和官方电话核验，保存群聊、文件和收款信息。",
      "enabled": true
    }
