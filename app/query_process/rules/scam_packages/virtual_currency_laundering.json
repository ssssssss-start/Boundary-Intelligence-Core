  "rules": [
    {
      "rule_id": "PKG_VIRTUAL_CURRENCY_LAUNDERING_001",
      "rule_name": "虚拟货币洗钱跑分配置化实时劝阻规则",
      "conditions": {
        "all": [
          "高佣金跑分"
        ],
        "any": [
          "出借账户收付款",
          "虚拟币转移资金",
          "资金来源不明",
          "账户被冻结"
        ],
        "min_any": 1
      },
      "risk_score": 97,
      "risk_level": "极高风险",
      "intervention_goal": "preserve_evidence",
      "explanation": "跑分、刷流水、代收代付叠加 USDT/虚拟币转移或出借账户，触发涉诈资金转移和洗钱风险。",
      "suggested_action": "立即停止收款、转账、买卖 USDT 或出借账户；保存招募、收款、钱包地址和转账记录，尽快联系银行/支付平台并向公安机关说明情况。",
      "enabled": true
    }
  ],
