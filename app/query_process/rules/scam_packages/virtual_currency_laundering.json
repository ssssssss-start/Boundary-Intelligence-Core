    {
      "feature_name": "账户被冻结",
      "keywords": [
        "银行卡冻结",
        "支付宝冻结",
        "微信冻结",
        "司法冻结",
        "止付",
        "涉案账户",
        "账户被冻结"
      ],
      "weight": 45,
      "explanation": "账户被司法冻结、止付或标记涉案，说明风险已外溢。"
