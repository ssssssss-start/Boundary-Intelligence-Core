  "rules": [
    {
      "rule_id": "PKG_SCHOLARSHIP_CODE_HIGH_001",
      "rule_name": "奖助学金/学费退费诈骗配置化实时劝阻规则",
      "conditions": {
        "all": [
          "奖助学金异常通知"
        ],
        "any": [
