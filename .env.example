MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=./models/modelscope_cache
HF_HOME=./models/huggingface_cache
MD_ROOT_DIR=./data

OPENAI_BASE_URL=https://api.deepseek.com
# 必填：DeepSeek 文本模型 key，用于主聊天、路由、RAG 总结等文本 LLM 能力。
OPENAI_API_KEY=
LLM_DEFAULT_MODEL=deepseek-chat
VL_MODEL=deepseek-chat
LLM_DEFAULT_TEMPERATURE=0.1

# 必填：Qwen 视觉模型 key，用于聊天页截图 OCR 与视觉风险分析。
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen-vl-plus
VISION_TEMPERATURE=0.1
VISION_MAX_TOKENS=1400
VISION_IMAGE_MAX_BYTES=8388608

BGE_M3=BAAI/bge-m3
BGE_M3_PATH=./models/BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
EMBEDDING_DIM=1024
ANTI_FRAUD_EMBEDDING_BACKEND=auto

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=anti_fraud_rag
# Transport and application-layer protection. In production use a secret
# manager, set TLS, and keep the previous key in ANTI_FRAUD_DATA_ENCRYPTION_KEYS
# during rotation (JSON: {"v1":"old","v2":"current"}).
MONGO_TLS=0
MONGO_TLS_CA_FILE=
MONGO_TLS_CERT_KEY_FILE=
MONGO_TLS_ALLOW_INVALID_CERTS=0
ANTI_FRAUD_DATA_ENCRYPTION_ENABLED=1
ANTI_FRAUD_DATA_ENCRYPTION_KEY=
ANTI_FRAUD_DATA_ENCRYPTION_KEY_ID=v1
ANTI_FRAUD_DATA_ENCRYPTION_KEYS=
ANTI_FRAUD_ENCRYPTION_REQUIRED=0
ANTI_FRAUD_ALLOW_EPHEMERAL_ENCRYPTION_KEY=0
ANTI_FRAUD_RETENTION_CHAT_DAYS=90
ANTI_FRAUD_RETENTION_CASE_DAYS=90
ANTI_FRAUD_RETENTION_SESSION_DAYS=90
ANTI_FRAUD_RETENTION_EVENT_DAYS=180
ANTI_FRAUD_RETENTION_REPORT_DAYS=730
ANTI_FRAUD_RETENTION_DRAFT_DAYS=7
ANTI_FRAUD_RETENTION_AUDIT_DAYS=365
ANTI_FRAUD_RETENTION_CACHE_DAYS=30
MILVUS_URL=http://localhost:19530
MILVUS_TLS=0
MILVUS_TOKEN=
MILVUS_TLS_CA_FILE=
MILVUS_TLS_SERVER_NAME=
MILVUS_TLS_CLIENT_CERT_FILE=
MILVUS_TLS_CLIENT_KEY_FILE=
MILVUS_TLS_CLIENT_KEY_PASSWORD=
ANTI_FRAUD_COLLECTION=anti_fraud_knowledge
ANTI_FRAUD_EDUCATION_COLLECTION=anti_fraud_education_knowledge

BGE_RERANKER_LARGE=./models/BAAI/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

VOICE_MODE=realtime_voice
VOICE_ASR_PROVIDER=mock_realtime
VOICE_TTS_PROVIDER=browser_fallback
VOICE_ENABLE_REALTIME_DIALOGUE=1
VOICE_ENABLE_INTERRUPTION=1
VOICE_MIN_CONFIDENCE=0.75
VOICE_SAVE_AUDIO=0
VOICE_SAVE_TRANSCRIPT=1
VOICE_DEFAULT_AUDIO_FORMAT=webm_opus

KOKORO_TTS_MODEL_DIR=tts/kokoro/kokoro-int8-multi-lang-v1_1
KOKORO_TTS_PYTHON=./.venv/bin/python
KOKORO_TTS_WORKER=tts/kokoro/kokoro_worker.py

FUNASR_ASR_HOST=127.0.0.1
FUNASR_ASR_PORT=10096
FUNASR_ASR_SSL=0
# Docker Compose 挂载宿主机上已下载的 FunASR 模型；可按实际位置修改。
FUNASR_MODELS_DIR=./models/funasr
FUNASR_ASR_MODE=2pass
FUNASR_ASR_CHUNK_SIZE=5,10,5
FUNASR_ASR_CHUNK_INTERVAL=10
FUNASR_ASR_TIMEOUT=15

LOG_CONSOLE_ENABLE=1
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=1
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION="7 days"

# Security baseline. Use explicit origins in production; never use '*' with credentials.
ANTI_FRAUD_CORS_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001,http://127.0.0.1:5173
ANTI_FRAUD_ALLOW_INSECURE_CORS=0
ANTI_FRAUD_ALLOW_INSECURE_DEFAULTS=0
ANTI_FRAUD_ADMIN_USERNAME=admin
# Required on a fresh database: use a unique password of at least 10 characters.
ANTI_FRAUD_ADMIN_PASSWORD=
# Optional review account. Leave empty unless a separate reviewer is needed.
ANTI_FRAUD_REVIEW_ADMIN_USERNAME=
ANTI_FRAUD_REVIEW_ADMIN_PASSWORD=
ANTI_FRAUD_ADMIN_MAX_FAILED_LOGINS=5
ANTI_FRAUD_ADMIN_LOCKOUT_MINUTES=15
# Set to 1 behind HTTPS. If omitted, X-Forwarded-Proto / request scheme is used.
ANTI_FRAUD_COOKIE_SECURE=0
ANTI_FRAUD_RATE_LIMIT_WINDOW_SECONDS=60
ANTI_FRAUD_MAX_REQUEST_BODY_BYTES=12582912
