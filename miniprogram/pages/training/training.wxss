.training-page {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.stats {
  display: flex;
  gap: 14rpx;
}

.stat-card {
  flex: 1;
  min-width: 0;
  min-height: 118rpx;
  border: 1rpx solid #ded5c8;
  border-radius: 16rpx;
  background: #fffdf8;
  padding: 18rpx;
  box-sizing: border-box;
}

.stat-card text {
  display: block;
  color: #62716d;
  font-size: 23rpx;
}

.stat-card strong {
  display: block;
  margin-top: 10rpx;
  color: #213b36;
  font-size: 29rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.level-meta {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  color: #60706b;
  font-size: 25rpx;
}

.level-title {
  margin-top: 18rpx;
  color: #162c28;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.scenario {
  margin-top: 22rpx;
  border-radius: 14rpx;
  background: #f7f1e8;
  color: #304742;
  padding: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.question {
  margin-top: 22rpx;
  color: #162c28;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 22rpx;
}

.option {
  min-height: 88rpx;
  border: 1rpx solid #d8cfc2;
  border-radius: 16rpx;
  background: #fffaf3;
  color: #213b36;
  padding: 20rpx 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
}

.option.selected {
  border-color: #6fb7aa;
  background: #e7f3ef;
  color: #174a43;
  font-weight: 700;
}

.result {
  margin-top: 22rpx;
  border-radius: 16rpx;
  padding: 22rpx;
  font-size: 27rpx;
  line-height: 1.65;
}

.result.correct {
  background: #e9f7ee;
  color: #1f693d;
}

.result.wrong {
  background: #fff0eb;
  color: #8a3a31;
}

.result-title {
  font-weight: 700;
  font-size: 30rpx;
}

.button-row button {
  flex: 1;
}

.empty-card .primary-btn {
  margin-top: 20rpx;
}

.battle-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: flex-start;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #17342f, #3d8f84);
  padding: 24rpx;
  color: #f7fbf7;
}

.battle-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
}

.battle-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: #e4f3e7;
}

.hp-pill {
  flex-shrink: 0;
  min-height: 48rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  padding: 0 16rpx;
  font-size: 23rpx;
  line-height: 48rpx;
}

.stage-map {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.stage-node {
  flex: 0 0 58rpx;
  min-height: 50rpx;
  border: 1rpx solid #d8cfc2;
  border-radius: 12rpx;
  background: #fffaf3;
  color: #60706b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
}

.stage-node.current {
  border-color: #23887d;
  background: #ccece6;
  color: #174a43;
}

.stage-node.cleared {
  border-color: #579b63;
  background: #e1f1df;
  color: #285b34;
}

.stage-node.locked {
  opacity: 0.55;
}

.hp-wrap {
  margin-top: 18rpx;
}

.hp-label {
  display: flex;
  justify-content: space-between;
  color: #425652;
  font-size: 24rpx;
  font-weight: 700;
}

.hp-track {
  margin-top: 8rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: #ded8cf;
  overflow: hidden;
}

.hp-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #2f9b86, #f0b948, #d94c4c);
}

.progress-dots {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.dot {
  flex: 1;
  min-width: 0;
  height: 34rpx;
  border-radius: 999rpx;
  background: #e4ded4;
  color: #786f65;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.dot.done {
  background: #58b59f;
  color: #fff;
}

.dot.current {
  background: #23645c;
  color: #fff;
}

.dot.failed {
  background: #c8454b;
  color: #fff;
}
