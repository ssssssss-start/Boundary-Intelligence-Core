.tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.tab {
  flex: 1;
  min-height: 70rpx;
  border: 1rpx solid #d8cfc2;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #60706b;
  background: #fffaf3;
  font-size: 27rpx;
}

.tab.active {
  border-color: #83bdb2;
  background: #e7f3ef;
  color: #23645c;
  font-weight: 700;
}

.check-btn {
  margin-top: 18rpx;
}

.result-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #162c28;
}

.metric-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #ebe3d9;
  font-size: 27rpx;
  color: #263238;
}

.metric-row text:last-child {
  color: #23645c;
  text-align: right;
}

.advice {
  margin-top: 18rpx;
  color: #263238;
  font-size: 27rpx;
  line-height: 1.55;
}

.raw {
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #f7f1e8;
  color: #6d6258;
  padding: 18rpx;
  font-size: 23rpx;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}
